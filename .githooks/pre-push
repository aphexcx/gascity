#!/usr/bin/env bash
set -euo pipefail

# git feeds "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref
# on stdin (see githooks(5)).

zero="0000000000000000000000000000000000000000"

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
# A real push exports its repository and index to hooks. Rediscover this
# checkout by cwd so helpers can also discover their own scratch repos.
repo_vars=$(git rev-parse --local-env-vars)
while IFS= read -r name; do unset "$name"; done <<< "$repo_vars"

# The ref list arrives once on stdin but two consumers need it: the beads chain
# and the Go-change scan below. Buffer it and replay it to each.
refs_stdin="$(cat)"

# `$(cat)` strips trailing newlines, so re-terminate the final line: `read`
# returns non-zero on an unterminated line and the scan would drop it. The
# emptiness guard keeps `printf` from manufacturing a blank ref line.
replay_refs() {
  [ -n "$refs_stdin" ] && printf '%s\n' "$refs_stdin"
  return 0
}

# .githooks owns core.hooksPath, so this call is the only thing keeping beads'
# own pre-push hook alive.
"$repo_root/.githooks/lib/beads-chain.sh" pre-push "$@" < <(replay_refs)

any_non_deletion=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # Branch deletion — nothing to test, nothing to guard.
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  any_non_deletion=1
done < <(replay_refs)

# Bead ownership/staleness guard (ga-fip9ps.1): re-checks bd claim state
# immediately before this push leaves the machine, once per invocation
# (not per ref) regardless of whether Go sources changed. A mayor ruling
# (reassign/close/hold/reroute) that landed after this push was queued
# must not be allowed to clobber a branch another agent has since taken
# over. Bypass: `git push --no-verify`.
if [ "$any_non_deletion" -eq 1 ]; then
  # shellcheck source=../scripts/push-ownership-guard.sh disable=SC1091
  . "$repo_root/scripts/push-ownership-guard.sh"
  if ! assert_bead_still_claimed; then
    exit 1
  fi
fi

# The fork runs cheap, deterministic checks locally. CI / required gates
# the integration and CLI process shards on the pull request's head.
if [ "$any_non_deletion" -eq 0 ]; then
  exit 0
fi
head=$(git rev-parse HEAD)
bases=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" != "$zero" ] || continue
  if ! commit=$(git rev-parse --verify "$local_sha^{commit}" 2>/dev/null) || [ "$commit" != "$head" ]; then
    echo "pre-push: check out the commit being pushed; it must match HEAD" >&2
    exit 1
  fi
  if [ "$remote_sha" = "$zero" ]; then
    ref=${GC_PREPUSH_BASE_REF:-refs/remotes/origin/integration}
    if ! remote_sha=$(git merge-base "$head" "$ref" 2>/dev/null); then
      echo "pre-push: no merge base with $ref; git fetch origin integration" >&2
      exit 1
    fi
  fi
  bases+=("$remote_sha")
done < <(replay_refs)
if ! git diff --quiet "$head" --; then
  echo "pre-push: commit or stash tracked changes before pushing" >&2
  exit 1
fi

# Git may have been launched by Make in dry-run or fix mode. Run fresh
# checks with read-only lint and full coverage of each selected package.
unset MAKEFLAGS GNUMAKEFLAGS MFLAGS MAKEOVERRIDES MAKEFILES
export LINT_FLAGS=--allow-serial-runners RUN=.
exec python3 - "$head" "${bases[@]}" <<'PY'
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import time


head = sys.argv[1]


def check_tree():
    if subprocess.run(["git", "diff", "--quiet", head, "--"]).returncode:
        sys.exit("pre-push: tracked files changed while checking the pushed commit")


def step(target, *args, env=None, cwd=None):
    # The checks read the checkout. Verify its tracked contents before and
    # after each command, including the final test or a script-only check.
    check_tree()
    start = time.monotonic()
    result = subprocess.run(args, env=env, cwd=cwd)
    elapsed = round(time.monotonic() - start)
    print(f"pre-push: {target} took {elapsed} s at load {os.getloadavg()[0]:.2f}",
          file=sys.stderr, flush=True)
    if result.returncode:
        sys.exit(result.returncode if result.returncode > 0 else 128 - result.returncode)
    check_tree()


def make(target, *variables, env=None):
    step(target, "make", "--no-print-directory", target, *variables, env=env)


def batches(values, prefix, separator, suffix=""):
    # Linux limits a single argv string. Count encoded bytes, including the
    # variable name, delimiters and terminating NUL, before invoking make.
    limit = 64 * 1024
    fixed = len((prefix + suffix).encode()) + 1
    batch = []
    size = fixed
    for value in sorted(values):
        length = len(value.encode())
        if fixed + length > limit:
            sys.exit("pre-push: one selector exceeds the 64 KiB argument limit")
        if batch and size + len(separator) + length > limit:
            yield prefix + separator.join(batch) + suffix
            batch = []
            size = fixed
        size += length + (len(separator) if batch else 0)
        batch.append(value)
    if batch:
        yield prefix + separator.join(batch) + suffix


def declared_tests(path):
    # Strip Go comments and literals before finding receiver-free declarations.
    # They may contain example test code, especially in raw string fixtures.
    literals = r"""//[^\n]*|/\*.*?\*/|`[^`]*`|"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'"""
    source = subprocess.check_output(["git", "show", f"{head}:{path}"]).decode("utf-8")
    code = re.sub(literals, " ", source, flags=re.DOTALL)
    return {name for name in re.findall(r"\bfunc\s+(Test\w*)\s*\(", code)
            if not name[4:5].islower()}


go_bases = []
changed_dirs = set()
command_tests = set()
check_harness = False
for base in dict.fromkeys(sys.argv[2:]):
    # With rename detection off a move is D + A, including a move across
    # packages. NUL delimiters preserve the exact path read from Git.
    diff = subprocess.check_output(["git", "diff", "--no-renames", "--name-status", "-z",
                                    base, head, "--", "*.go", "scripts", ".githooks",
                                    "Makefile", "go.mod", "go.sum"])
    if diff:
        check_harness = True
    has_go = False
    fields = iter(diff.split(b"\0")[:-1])
    for status in fields:
        path = Path(os.fsdecode(next(fields)))
        if not path.name.endswith(".go"):
            continue
        has_go = True
        changed_dirs.add(path.parent.as_posix())
        if status != b"D" and path.parent == Path("cmd/gc") and path.name.endswith("_test.go"):
            command_tests.add(path)
    if has_go:
        go_bases.append(base)

make("check-inventories", "GC_CHECK_INVENTORIES_TIMEOUT=300")
if check_harness:
    # These are standalone fixtures. Give each its own home and Git config.
    # Share the Go module/toolchain cache without passing caller test knobs.
    fixture_env = {key: os.environ[key] for key in
                   ("PATH", "USER", "LOGNAME", "SHELL", "LANG", "GOMODCACHE", "GOTMPDIR")
                   if key in os.environ}
    fixture_env.update(GOPATH=os.environ.get("GOPATH") or str(Path.home() / "go"),
                       GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL=os.devnull)
    for script in ("test-push-gate-lock.sh", "test-local-concurrency.sh"):
        with tempfile.TemporaryDirectory(prefix="gc-push-fixture-", dir="/var/tmp") as home:
            step(script, "bash", Path("scripts", script).absolute(),
                 env=dict(fixture_env, HOME=home, TMPDIR=home), cwd=home)
if not go_bases:
    sys.exit(0)

# A deletion or move also changes the source package if it survives at head.
tree = subprocess.check_output(["git", "ls-tree", "-rz", head])
dirs = set()
for entry in tree.split(b"\0"):
    if not entry.endswith(b".go"):
        continue
    header, raw_path = entry.split(b"\t", 1)
    path = Path(os.fsdecode(raw_path))
    if path.name.startswith((".", "_")):
        command_tests.discard(path)
        continue
    if path.parent.as_posix() in changed_dirs:
        dirs.add(path.parent.as_posix())
    if path in command_tests and header.startswith(b"120000 "):
        print(f"pre-push: {path} left to CI (symlinked test file)", file=sys.stderr)
        command_tests.remove(path)
for directory in dirs:
    # The Make recipes expand package directories as shell word lists.
    if not re.fullmatch(r"[\w./~+-]+", directory):
        sys.exit(f"pre-push: unsupported Go package path {directory!r}")
packages = {"." if directory == "." else "./" + directory for directory in dirs}

for base in go_bases:
    make("fmt-check-changed", "LINT_CHANGED_SCOPE=tracked", "LINT_CHANGED_REF=" + base)
# Lint the union once, then use its build-tag exclusions for package tests.
with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8") as selected, \
     tempfile.NamedTemporaryFile(mode="r", encoding="utf-8") as exclusions:
    selected.writelines(directory + "\n" for directory in sorted(dirs))
    selected.flush()
    lint_env = dict(os.environ, GC_PREPUSH_PACKAGE_DIRS=selected.name,
                    GC_PREPUSH_TAGGED_PACKAGES=exclusions.name)
    make("lint-changed", "LINT_CHANGED_SCOPE=tracked", "LINT_CHANGED_REF=" + go_bases[0], env=lint_env)
    tagged = set(exclusions.read().splitlines())
for package in sorted(tagged):
    print(f"pre-push: {package} left to CI (build-tagged)", file=sys.stderr, flush=True)
packages.difference_update(tagged)
make("vet")
make("test-fsys-darwin-compile")
for group in batches(packages - {"./cmd/gc"}, "PKG=", " "):
    make("test-pkg", group, "COUNT=1")
if "./cmd/gc" in packages:
    make("test-pkg", "PKG=./cmd/gc", "RUN=^$", "COUNT=1")
    names = {name for path in command_tests for name in declared_tests(path)}
    if names:
        for selector in batches(names, "RUN=^(", "|", ")$"):
            make("test-pkg", "PKG=./cmd/gc", selector, "COUNT=1")
    else:
        print("pre-push: no tests declared in changed cmd/gc test files", file=sys.stderr)
PY
