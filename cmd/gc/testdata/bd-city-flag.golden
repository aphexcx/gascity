{
  "Cwd": "{root}/city",
  "Args": [
    "{root}/bin/bd",
    "sql",
    "SELECT 1"
  ],
  "Env": [
    "BD_BACKUP_ENABLED=false",
    "BD_BIN=",
    "BD_DOLT_SYNC_CLI_REMOTES=false",
    "BD_EXPORT_AUTO=false",
    "BD_ROUTING_MODE=off",
    "BEADS_BACKEND=",
    "BEADS_BACKUP_ENABLED=false",
    "BEADS_CREDENTIALS_FILE=",
    "BEADS_DIR={root}/city/.beads",
    "BEADS_DOLT_AUTO_START=0",
    "BEADS_DOLT_CREDENTIAL_COMMAND='{gc}' internal beads-credential",
    "BEADS_DOLT_PASSWORD=",
    "BEADS_DOLT_SERVER_HOST=",
    "BEADS_DOLT_SERVER_PORT=",
    "BEADS_DOLT_SERVER_SOCKET=",
    "BEADS_DOLT_SERVER_USER=",
    "BEADS_DOLT_SYNC_CLI_REMOTES=false",
    "BEADS_ROUTING_MODE=off",
    "GC_BEADS_BACKEND=",
    "GC_BEADS_PREFIX=hpt",
    "GC_BIN={gc}",
    "GC_CITY={root}/city",
    "GC_CITY_PATH={root}/city",
    "GC_CITY_RUNTIME_DIR={root}/city/.gc/runtime",
    "GC_CONTROL_DISPATCHER_TRACE_DEFAULT={root}/city/.gc/runtime/control-dispatcher-trace.log",
    "GC_DOLT_HOST=",
    "GC_DOLT_PASSWORD=",
    "GC_DOLT_PORT=",
    "GC_DOLT_USER=",
    "GC_HOME={root}/gc-home",
    "GC_RIG=",
    "GC_RIG_ROOT=",
    "GC_STORE_ROOT={root}/city",
    "GC_STORE_SCOPE=city",
    "GC_TEST_BD_CAPTURE_FILE={root}/capture",
    "HOME={root}",
    "PATH={root}/bin:/usr/bin:/bin:/usr/sbin",
    "PWD={root}/city"
  ]
}
