load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "federation",
    srcs = [
        "mayclaim.go",
        "ownerlabel.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/federation",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "federation_test",
    srcs = [
        "mayclaim_test.go",
        "ownerlabel_test.go",
        "testenv_import_test.go",
    ],
    embed = [":federation"],
    deps = ["//internal/testenv"],
)

