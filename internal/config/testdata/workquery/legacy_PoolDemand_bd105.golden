sh -c 'target="$1"; ready_json=$({ gc_ready_json=$(bd ready --include-ephemeral --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --json --limit 0) || exit $?; gc_unshipped_ready_json=$(printf "%s" "$gc_ready_json" | jq '\''[.[] | select((.metadata["gc.work_outcome"] // "") != "shipped")]'\'') || gc_unshipped_ready_json="$gc_ready_json"; printf "%s" "$gc_unshipped_ready_json"; }) || exit $?; legacy_candidates=$({ gc_ready_json=$(bd ready --include-ephemeral --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --json --sort oldest --limit 0) || exit $?; gc_unshipped_ready_json=$(printf "%s" "$gc_ready_json" | jq '\''[.[] | select((.metadata["gc.work_outcome"] // "") != "shipped")]'\'') || gc_unshipped_ready_json="$gc_ready_json"; printf "%s" "$gc_unshipped_ready_json"; }) || exit $?; legacy_json=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select((.metadata["gc.routed_to"] // "") == "")]'\'') || exit $?; legacy_ephemeral_json=$(printf "[]"); printf "%s\n%s\n%s\n" "$ready_json" "$legacy_json" "$legacy_ephemeral_json" | jq -s "(add // []) | unique_by(.id) | length"' -- rig/control-dispatcher