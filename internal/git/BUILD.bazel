load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "git",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "github.com/gastownhall/gascity/internal/git",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/gitcred",
    ] + select({
        "@rules_go//go/platform:aix": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:android": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:darwin": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:dragonfly": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:freebsd": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:illumos": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:ios": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:js": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:linux": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:netbsd": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:openbsd": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:osx": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:plan9": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:qnx": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:solaris": [
            "//internal/processgroup",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "git_test",
    srcs = [
        "clone_hardening_test.go",
        "clone_scrub_test.go",
        "clone_test.go",
        "executable_test.go",
        "git_test.go",
        "revision_test.go",
        "sshkeepalive_test.go",
        "testenv_import_test.go",
        "unreachable_commits_test.go",
        "worktree_ops_test.go",
    ],
    embed = [":git"],
    deps = [
        "//internal/testenv",
        "//internal/testutil",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
