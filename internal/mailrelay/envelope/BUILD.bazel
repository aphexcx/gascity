load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "envelope",
    srcs = [
        "grant.go",
        "keys.go",
        "seal.go",
        "wire.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/mailrelay/envelope",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/citywriteauth"],
)

go_test(
    name = "envelope_test",
    srcs = [
        "envelope_test.go",
        "grant_test.go",
        "testenv_import_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":envelope"],
    deps = [
        "//internal/citywriteauth",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
