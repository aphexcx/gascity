load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "cachevalidation",
    srcs = ["cache_validation.go"],
    importpath = "github.com/gastownhall/gascity/internal/runtime/cachevalidation",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/cacheexec",
        "//internal/runtime",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
