load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "lanectx",
    srcs = ["lane_context.go"],
    importpath = "github.com/gastownhall/gascity/internal/runtime/lanectx",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/runtime",
        "//internal/shellquote",
    ],
)

go_test(
    name = "lanectx_test",
    srcs = [
        "lane_context_test.go",
        "testenv_import_test.go",
    ],
    embed = [":lanectx"],
    deps = ["//internal/testenv"],
)

