load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "exec",
    srcs = [
        "cutover.go",
        "exec.go",
        "handshake.go",
        "json.go",
        "seams.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/runtime/exec",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/execgrace",
        "//internal/runtime",
    ],
)

go_test(
    name = "exec_test",
    srcs = [
        "cutover_test.go",
        "exec_connection_test.go",
        "exec_reuse_test.go",
        "exec_test.go",
        "handshake_test.go",
        "json_test.go",
        "seams_test.go",
        "testenv_import_test.go",
    ] + select({
        "@rules_go//go/platform:aix": [
            "exec_barrier_unix_test.go",
        ],
        "@rules_go//go/platform:android": [
            "exec_barrier_unix_test.go",
        ],
        "@rules_go//go/platform:darwin": [
            "exec_barrier_unix_test.go",
        ],
        "@rules_go//go/platform:dragonfly": [
            "exec_barrier_unix_test.go",
        ],
        "@rules_go//go/platform:freebsd": [
            "exec_barrier_unix_test.go",
        ],
        "@rules_go//go/platform:ios": [
            "exec_barrier_unix_test.go",
        ],
        "@rules_go//go/platform:linux": [
            "exec_barrier_unix_test.go",
        ],
        "@rules_go//go/platform:netbsd": [
            "exec_barrier_unix_test.go",
        ],
        "@rules_go//go/platform:openbsd": [
            "exec_barrier_unix_test.go",
        ],
        "@rules_go//go/platform:solaris": [
            "exec_barrier_unix_test.go",
        ],
        "@rules_go//go/platform:windows": [
            "exec_barrier_windows_test.go",
        ],
        "//conditions:default": [],
    }),
    embed = [":exec"],
    deps = [
        "//internal/runtime",
        "//internal/runtime/runtimetest",
        "//internal/testenv",
    ],
)

